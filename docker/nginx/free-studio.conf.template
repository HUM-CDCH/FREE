# Entry point of the nginx containers: development (compose.override.yaml)
# and the production bundled nginx (compose.nginx.yaml). The nginx image's
# entrypoint renders every /etc/nginx/templates/*.template with envsubst;
# free-studio-locations.inc.template renders alongside this file and carries
# the application proxy behavior shared with the production host nginx. Only
# this wrapper is container-specific: the TLS files (mkcert's in development,
# the deployment's FREE_TLS_CERT_PATH and FREE_TLS_KEY_PATH in production) and
# the root redirect on a server that serves nothing else.
map $http_upgrade $free_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/tls/studio.crt;
    ssl_certificate_key /etc/nginx/tls/studio.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = / {
        absolute_redirect off;
        return 308 ${STUDIO_BASE_PATH}/;
    }

    include /etc/nginx/conf.d/free-studio-locations.inc;
}
