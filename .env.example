# Development needs no .env: `pnpm dev` serves https://localhost:8443/free and
# signs in through the local mock OIDC identity service. DATABASE_URL is only
# for host-run tooling (tests, `pnpm --filter studio dev`, Prisma scripts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/free

# Everything below is deployment configuration for
# `node scripts/free.mjs production` (real Entra values are also read by
# compose.entra.yaml in development). TLS lives in the host-managed nginx unless
# FREE_NGINX=container (below). See docs/operations/deployment.md.
STUDIO_ORIGIN=https://free.example.edu
STUDIO_BASE_PATH=/free
FREE_SESSION_SECRET=<canonical-base64-output>
FREE_POSTGRES_PASSWORD=<hex-output>
FREE_PARSING_POSTGRES_PASSWORD=<separately-generated-hex-output>
FREE_ENTRA_TENANT_ID=<microsoft-entra-tenant-uuid>
FREE_ENTRA_CLIENT_ID=<application-client-uuid>
FREE_ENTRA_CLIENT_CERT_PATH=/srv/free-secrets/entra-client.pem
FREE_ENTRA_CLIENT_CERT_THUMBPRINT=<sha256-certificate-thumbprint>
# Hosts without a managed nginx: terminate TLS in the bundled nginx container
# (compose.nginx.yaml) on FREE_NGINX_PORT instead. STUDIO_ORIGIN carries the
# same port.
# FREE_NGINX=container
# FREE_NGINX_PORT=443
# FREE_TLS_CERT_PATH=/srv/free-tls/studio.crt
# FREE_TLS_KEY_PATH=/srv/free-tls/studio.key

# The Parsing Service, durable worker, and model servers are owned by this
# checkout. Native PDFs parse on the CPU; scanned OCR and extraction run on
# vLLM servers in the GPU overlay. The launcher probes GPU access in auto mode.
FREE_GPU=auto
# Extraction's models (Hugging Face repo ids, as vLLM serves them) and their
# servers' budgets: the instruction model reasons (and may fill fields), the
# NuExtract template extractor fills fields by default.
KEI_EXTRACT_MODEL=Qwen/Qwen3.8-27B-FP8
EXTRACT_MAX_MODEL_LEN=32768
EXTRACT_KV_CACHE_BYTES=8G
KEI_NUEXTRACT_MODEL=numind/NuExtract3-FP8
NUEXTRACT_MAX_MODEL_LEN=32768
NUEXTRACT_KV_CACHE_BYTES=4G
# DGX Spark: set VLLM_IMAGE to a tested ARM64/GB10-compatible vLLM image that
# supports the qwen3_5 architecture; one image serves every model server.

# Only needed if model-config.json configures a Claude Code connection: the
# `claude` CLI runs inside the studio container as a subprocess and cannot
# reach a developer's local login (macOS Keychain isn't visible to Linux
# containers), so it authenticates from this token instead. Generate it with
# `claude setup-token` (prints "export CLAUDE_CODE_OAUTH_TOKEN=..."); it is a
# long-lived (1-year) credential, so treat it like a password.
CLAUDE_CODE_OAUTH_TOKEN=<claude-setup-token-output>
