# Development needs no .env: `pnpm dev` serves https://localhost:8443/free and
# signs in through the local mock OIDC identity service. DATABASE_URL is only
# for host-run tooling (tests, `pnpm --filter studio dev`, Prisma scripts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/free

# Everything below is deployment configuration for
# `node scripts/free.mjs production` (real Entra values are also read by
# compose.entra.yaml in development). TLS lives in the host-managed nginx, not
# here. See docs/operations/deployment.md.
STUDIO_ORIGIN=https://free.example.edu
STUDIO_BASE_PATH=/free
FREE_SESSION_SECRET=<canonical-base64-output>
FREE_POSTGRES_PASSWORD=<hex-output>
FREE_ENTRA_TENANT_ID=<microsoft-entra-tenant-uuid>
FREE_ENTRA_CLIENT_ID=<application-client-uuid>
FREE_ENTRA_CLIENT_CERT_PATH=/srv/free-secrets/entra-client.pem
FREE_ENTRA_CLIENT_CERT_THUMBPRINT=<sha256-certificate-thumbprint>

# Only needed if model-config.json configures a Claude Code connection: the
# `claude` CLI runs inside the studio container as a subprocess and cannot
# reach a developer's local login (macOS Keychain isn't visible to Linux
# containers), so it authenticates from this token instead. Generate it with
# `claude setup-token` (prints "export CLAUDE_CODE_OAUTH_TOKEN=..."); it is a
# long-lived (1-year) credential, so treat it like a password.
CLAUDE_CODE_OAUTH_TOKEN=<claude-setup-token-output>
