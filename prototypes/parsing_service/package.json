{
  "name": "parsing-service",
  "private": true,
  "scripts": {
    "install:python": "pnpm install:python:cpu",
    "install:python:cpu": "uv sync --extra ocr-cpu",
    "install:python:gpu": "uv sync --extra ocr-gpu",
    "dev": "uv run --no-sync python -X utf8 -m fastapi dev main.py --host 127.0.0.1 --port 8000",
    "dev:cpu": "pnpm install:python:cpu && pnpm dev",
    "dev:gpu": "pnpm install:python:gpu && pnpm dev",
    "test": "uv run --no-sync python -m unittest discover -s tests",
    "test:cpu": "pnpm install:python:cpu && pnpm test",
    "test:gpu": "pnpm install:python:gpu && pnpm test"
  }
}
