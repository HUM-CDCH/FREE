              <span className="truncate">{hintText}</span>
            </p>
          </div>
        </section>
        {railOpen && (
          <div
            className="z-5 -mr-0.75 w-1.25 shrink-0 cursor-col-resize bg-transparent transition-colors hover:bg-accent-soft"
            title="Drag to resize"
