  },
  {
    "anchorId": "anchor_bd4651d7848d16ab759b773fffd2d79477596f993a671e5bf5617646c6a0da6e",
    "text": "PERSONE PREOCCUPATE PER I CAMBIAMENTI CLIMATICI",
    "page": 1,
    "kind": "text"
  },
  {
    "anchorId": "anchor_c7d0f3c5360b97f1fb96f8be359152251ee97d6dcaf1905ffe0eeb5a7440ea8d",
    "text": "1 SU 2 PER L'INQUINAMENTO DELL'ARIA",
    "page": 1,
    "kind": "text"
  },
  {
    "anchorId": "anchor_ba2e73819859daeb3fad7be3e4e9167dfce800c6b22d363bac3327abdd3cddb3",
    "text": "anno 2024, persone con 14 anni e più",
    "page": 1,
    "kind": "text"
  },
  {
    "anchorId": "anchor_39159ea1d38ef4b85bf4a20bace3024a2fb09ccb80086fcfc2bb5b723f535e3e",
