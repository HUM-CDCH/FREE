specification {
  element system
  element component
  element artifact {
    style {
      shape storage
      color gray
    }
  }
}

model {
  dataset = artifact 'Experiment dataset' 'Claims and canonical document anchors.' 'JSON'

  benchmark = system 'Grounding Lab benchmark' 'Runs the A-H evidence-linking policy comparison.' {
    lexical = component 'Bounded lexical tier' 'Finds zero, one, or multiple bounded value occurrences; zero strict hits fall back to whitespace-tolerant hits (OCR/PDF spacing).' 'pipeline.lexical_tier'
    bare = component 'Bare claim renderer' 'Passes only the scalar value.' 'model_benchmark.claim_text'
    rich = component 'Rich hit-set renderer' 'Passes the field name, scalar value, and sibling values.' 'model_benchmark.claim_text'
    retriever = component 'Dense retriever' 'MiniLM, Jina ColBERT v2, or Liquid LFM2.5-ColBERT ranks every anchor and returns the top K.' 'Sentence Transformers'
    reranker = component 'Cross-encoder reranker' 'BGE v2 m3, Qwen3 0.6B, or Nemotron 1B scores each candidate.' 'PyTorch / Transformers'
    verifier = component 'Claim-evidence verifier' 'MiniCheck scores whether each candidate independently supports the rich claim.' 'Transformers'
    gates = component 'Decision gates' 'Applies score thresholds, verifier uniqueness, and the non-verbatim confidence cap.' 'calibrate.decide'
    scoring = component 'Evaluation' 'Routes sub-threshold links to review and measures supported links, abstentions, wrong auto-links, latency, confidence intervals, and VRAM.' 'model_benchmark'
  }

  report = artifact 'Benchmark report' 'Held-out measurements and per-document results.' 'Markdown'

  dataset -> benchmark.lexical 'Claim and raw anchor text'
  benchmark.lexical -> benchmark.scoring 'One hit: link (A-F); no hits at all: abstain (E, H)'
  benchmark.lexical -> benchmark.bare 'Zero hits (A-D, F); multiple hits (A-C)'
  benchmark.lexical -> benchmark.rich 'Multiple hits (D-F, H); whitespace-tolerant hits and one hit claimed under two fields (E, capped); every claim (G); every strict one hit (H)'
  benchmark.bare -> benchmark.retriever 'Zero hits (A-D, F); multiple hits (A-B)'
  benchmark.retriever -> benchmark.reranker 'Top 10 (A; F uses ColBERT); top 30 (B; C-D zero-hit fallback)'
  benchmark.bare -> benchmark.reranker 'All lexical hits (C multiple-hit)'
  benchmark.rich -> benchmark.reranker 'All lexical hits (D-F multiple-hit; H one-hit and multiple-hit)'
  benchmark.reranker -> benchmark.gates 'Best score, margin, and verbatim-containment flag'
  benchmark.retriever -> benchmark.verifier 'Zero-hit candidates (G)'
  benchmark.rich -> benchmark.verifier 'Claim plus lexical candidates (G)'
  benchmark.verifier -> benchmark.gates 'Independent support probabilities (G)'
  benchmark.gates -> benchmark.scoring 'Link or abstention plus confidence'
  benchmark.scoring -> report 'Aggregate measurements'
}

views {
  view policy_comparison {
    title 'Grounding Lab — policies A-H'
    description '''
      Every claim first enters bounded lexical containment. The labels on each
      relationship identify which policies use that path. The runner stores raw
      candidate scores and the thresholds are applied afterwards, so retuning one
      can turn a link into an abstention without re-running inference. Every claim
      still ends as a link or an abstention with confidence; evaluation counts
      a sub-threshold link in a review bucket without adding a verdict schema.
    '''
    include dataset, benchmark.*, report
  }

  dynamic view current_policy_e {
    title 'Grounding Lab — current policy E'
    description '''
      Policy E links one bounded verbatim hit and sends multiple-hit claims
      through rich rendering and cross-encoder reranking. Two cases also reach
      the reranker but are capped at 0.25 so they can never auto-accept: zero
      verbatim hits fall back to whitespace-tolerant hits (OCR/PDF spacing),
      and a value the extraction claims under two different fields is scored
      field-aware even with one verbatim hit. Only a value with no hits at all
      abstains without neural scoring. Qwen3 0.6B is the pinned scorer;
      Nemotron 1B measures better on this same path but has not replaced the
      pin. The result is a link or abstention with confidence; a future
      production path may use that confidence to route human review.
    '''
    dataset -> benchmark.lexical 'Scan raw anchor text for the bounded scalar'
    alt {
      when 'no hits, even whitespace-tolerant' {
        benchmark.lexical -> benchmark.scoring 'Record an abstention without neural scoring'
      }
      when 'zero verbatim hits, whitespace-tolerant hits' {
        benchmark.lexical -> benchmark.rich 'Render field, value, and siblings'
        benchmark.rich -> benchmark.reranker 'Score the tolerant hits as non-verbatim (capped at 0.25)'
      }
      when 'one hit, value claimed under one field' {
        benchmark.lexical -> benchmark.scoring 'Record the lexical link at confidence 1.0'
      }
      when 'one hit, value claimed under two fields' {
        benchmark.lexical -> benchmark.rich 'Render field, value, and siblings'
        benchmark.rich -> benchmark.reranker 'Score the hit field-aware as non-verbatim (capped at 0.25)'
      }
      else 'multiple hits' {
        benchmark.lexical -> benchmark.rich 'Render field, value, and siblings'
        benchmark.rich -> benchmark.reranker 'Score every lexical hit with Qwen3 0.6B'
      }
    }
    benchmark.reranker -> benchmark.gates 'Return best score, margin, and containment flag'
    benchmark.gates -> benchmark.scoring 'Record a link or abstention plus confidence'
    benchmark.scoring -> report 'Aggregate held-out measurements'
  }

  dynamic view experimental_policy_f {
    title 'Grounding Lab — experimental policy F'
    description '''
      Policy F keeps E's direct one-hit path and rich multiple-hit reranking,
      but sends zero-hit claims through top-10 ColBERT retrieval and Nemotron
      1B. Jina and Liquid retriever variants are compared diagnostically under
      their respective license restrictions.
    '''
    dataset -> benchmark.lexical 'Scan raw anchor text for the bounded scalar'
    alt {
      when 'zero hits' {
        benchmark.lexical -> benchmark.bare 'Pass the bare scalar'
        benchmark.bare -> benchmark.retriever 'Retrieve top 10 with Jina or Liquid ColBERT'
        benchmark.retriever -> benchmark.reranker 'Score candidates with Nemotron 1B'
      }
      when 'one hit' {
        benchmark.lexical -> benchmark.scoring 'Record the lexical link at confidence 1.0'
      }
      else 'multiple hits' {
        benchmark.lexical -> benchmark.rich 'Render field, value, and siblings'
        benchmark.rich -> benchmark.reranker 'Score every lexical hit with Nemotron 1B'
      }
    }
    benchmark.reranker -> benchmark.gates 'Return best score, margin, and containment flag'
    benchmark.gates -> benchmark.scoring 'Record a link or abstention plus confidence'
    benchmark.scoring -> report 'Aggregate diagnostic measurements'
  }

  dynamic view experimental_policy_g {
    title 'Grounding Lab — experimental policy G'
    description '''
      Policy G removes reranking. Liquid ColBERT proposes ten candidates only
      for zero-hit claims; one-hit and multiple-hit claims keep their lexical
      candidates. MiniCheck verifies every candidate independently. Exactly one
      candidate must clear the calibrated support threshold or the claim abstains.
    '''
    dataset -> benchmark.lexical 'Scan raw anchor text for the bounded scalar'
    alt {
      when 'zero hits' {
        benchmark.lexical -> benchmark.rich 'Render one claim sentence'
        benchmark.rich -> benchmark.retriever 'Retrieve top 10 with Liquid ColBERT'
        benchmark.retriever -> benchmark.verifier 'Verify each retrieved candidate'
      }
      when 'one hit' {
        benchmark.lexical -> benchmark.rich 'Render one claim sentence'
        benchmark.rich -> benchmark.verifier 'Verify the lexical candidate'
      }
      else 'multiple hits' {
        benchmark.lexical -> benchmark.rich 'Render one claim sentence'
        benchmark.rich -> benchmark.verifier 'Verify every lexical candidate'
      }
    }
    benchmark.verifier -> benchmark.gates 'Require exactly one support score above the threshold'
    benchmark.gates -> benchmark.scoring 'Record a link or abstention plus confidence'
    benchmark.scoring -> report 'Aggregate diagnostic measurements'
  }

  dynamic view experimental_policy_h {
    title 'Grounding Lab — experimental policy H'
    description '''
      Policy H keeps E's zero-hit behavior but reranks every strict single hit
      with a rich claim and its real verbatim flag. Cross-validation tunes the
      absolute-score abstain gate and the confidence accept gate. It routes the
      Poul Kragh trap to review, but sends 59 links to review overall.
    '''
    dataset -> benchmark.lexical 'Scan raw anchor text for the bounded scalar'
    alt {
      when 'no strict hits' {
        benchmark.lexical -> benchmark.rich 'Score whitespace-tolerant hits; otherwise abstain'
        benchmark.rich -> benchmark.reranker 'Cap non-verbatim picks at 0.25'
      }
      when 'one strict hit' {
        benchmark.lexical -> benchmark.rich 'Render field, value, and siblings'
        benchmark.rich -> benchmark.reranker 'Score the hit with Nemotron 1B and keep verbatim status'
      }
      else 'multiple strict hits' {
        benchmark.lexical -> benchmark.rich 'Render field, value, and siblings'
        benchmark.rich -> benchmark.reranker 'Score every lexical hit with Nemotron 1B'
      }
    }
    benchmark.reranker -> benchmark.gates 'Gate on absolute score; retain confidence and containment cap'
    benchmark.gates -> benchmark.scoring 'Count accepted, reviewed, or abstained outcomes'
    benchmark.scoring -> report 'Aggregate five-fold measurements'
  }
}
