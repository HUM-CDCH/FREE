{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "dist-lib/index.d.ts",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https --host 0.0.0.0 --strictPort",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "test": "vitest run --exclude api/_model.live.test.ts",
    "test:live-model": "vitest run api/_model.live.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:base-path": "playwright test --config playwright.base-path.config.ts",
    "test:e2e:developer": "playwright test --config playwright.developer-ui.config.ts",
    "typecheck": "tsc -b --pretty false",
    "start": "node dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@hono/node-server": "^2.0.12",
    "@napi-rs/canvas": "^1.0.3",
    "@anthropic-ai/claude-code": "2.1.263",
    "@napi-rs/keyring": "^1.2.0",
    "@openai/codex": "0.153.4",
    "@tailwindcss/vite": "^4.3.0",
    "@xstate/react": "^6.1.0",
    "ai": "^7.0.93",
    "ai-sdk-ollama": "^4.2.0",
    "ai-sdk-provider-claude-code": "^4.3.1",
    "ai-sdk-provider-codex-cli": "^2.1.2",
    "db": "workspace:*",
    "env-paths": "^4.0.0",
    "extraction": "workspace:*",
    "extraction-result-export": "workspace:*",
    "hono": "^4.13.7",
    "pdfjs-dist": "^6.3.289",
    "pluralize": "^8.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "studio-configuration": "workspace:*",
    "tailwindcss": "^4.3.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.1",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fflate": "^0.8.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
