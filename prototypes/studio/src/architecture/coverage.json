      "prototypes/studio/src/assets/**", "prototypes/studio/src/evidenceNavigation*",
      "prototypes/studio/src/extraction*", "prototypes/studio/src/resultStats*",
      "prototypes/studio/src/schemaChanges*", "prototypes/studio/src/schemaRevisions*",
      "prototypes/studio/src/schemaSaveCoordinator*", "prototypes/studio/src/useExtraction*",
      "prototypes/studio/src/useOpenDocumentTabs*"
