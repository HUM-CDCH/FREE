{
  "name": "free-root",
  "private": true,
  "scripts": {
    "postinstall": "pnpm db:generate && pnpm --recursive --if-present install:python",
    "db:generate": "pnpm --filter db contract:emit",
    "db:reset": "pnpm --filter db db:reset",
    "account": "pnpm --filter studio account",
    "setup": "pnpm --filter db db:init",
    "start": "pnpm dev",
    "predev": "pnpm db:generate && pnpm --filter db db:verify",
    "dev": "pnpm --recursive --parallel dev",
    "test": "pnpm --recursive test",
    "test:ci": "node -e \"if (!process.env.EXTRACTION_TEST_DATABASE_URL || process.env.DATABASE_URL !== process.env.EXTRACTION_TEST_DATABASE_URL) throw new Error('DATABASE_URL must equal the disposable EXTRACTION_TEST_DATABASE_URL')\" && pnpm test && pnpm --filter studio exec playwright test e2e/canonical-evidence-lifecycle.spec.ts --workers=1",
    "prebuild": "pnpm db:generate",
    "build": "pnpm --filter studio build",
    "architecture:dev": "likec4 dev docs/architecture",
    "architecture:check": "likec4 validate docs/architecture",
    "architecture:build": "likec4 build docs/architecture -o artifacts/architecture/site --use-hash-history"
  },
  "devDependencies": {
    "likec4": "^1.59.2"
  }
}
