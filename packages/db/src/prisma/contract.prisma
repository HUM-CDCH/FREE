// use prisma-next
types {
  Uuid         = String @db.Uuid
  Timestamptz6 = DateTime @db.Timestamptz(6)
}

model ResearcherAccount {
  id              Uuid         @id @default(uuid())
  tenantId        Uuid
  objectId        Uuid
  displayName     String
  createdAt       Timestamptz6 @default(now())
  updatedAt       temporal.updatedAt()
  projectContexts ProjectContext[]
  modelConfiguration ModelConfiguration?

  @@unique([tenantId, objectId])
}

// One Researcher Account's Model Configuration: its Model Connections (whether each uses a key, never the key),
// Capability Routes, Extraction Model Choice and Ingestion Model Choice. Studio validates `document` before every
// write. A committed row always has a document: null exists only inside the first apply's transaction, which
// creates the row to lock it (packages/db/src/model-configuration-store.ts).
model ModelConfiguration {
  researcherAccountId Uuid              @id
  document            Json?
  updatedAt           Timestamptz6      @default(now())
  researcherAccount   ResearcherAccount @relation(fields: [researcherAccountId], references: [id], onDelete: Cascade)
}

enum ExtractionOutcome {
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SchemaRevisionOrigin {
  SUGGESTION
  RESEARCHER_EDIT
  MODEL_EDIT
}

enum ProjectOperationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ExtractionJobKind {
  INTERACTIVE
  BATCH_MEMBER
}

enum BatchSchemaSuggestionPhase {
  SOURCES
  MERGING
  READY
  HETEROGENEOUS
}

model ProjectContext {
  researcherAccountId Uuid
  id                Uuid               @id @default(uuid())
  name              String
  createdAt         Timestamptz6       @default(now())
  researcherAccount ResearcherAccount @relation(fields: [researcherAccountId], references: [id], onDelete: Restrict)
  sourceDocuments   SourceDocument[]
  extractionSchemas ExtractionSchema[]
  batchExtractions  BatchExtraction[]
  extractionJobs    ExtractionJob[]
  batchSchemaSuggestions BatchSchemaSuggestion[]

  @@index([researcherAccountId])
}

model SourceDocument {
  id                     Uuid                           @id @default(uuid())
  projectContextId       Uuid
  ingestionKey           Uuid
  contentSha256          String
  mediaType              String
  originalName           String?
  createdAt              Timestamptz6                   @default(now())
  projectContext         ProjectContext                 @relation(fields: [projectContextId], references: [id], onDelete: Cascade)
  representations        SourceRepresentationRevision[]
  annotationSetRevisions AnnotationSetRevision[]

  @@unique([projectContextId, ingestionKey])
  @@unique([projectContextId, contentSha256])
}

model SourceRepresentationRevision {
  id                     Uuid                       @id @default(uuid())
  sourceDocumentId       Uuid
  revisionNumber         Int
  artifactReference      String
  artifactSha256         String
  contractVersion        String
  preprocessId           String
  parserName             String
  parserVersion          String
  reprocessKey           Uuid?
  reprocessFingerprint   String?
  createdAt              Timestamptz6               @default(now())
  sourceDocument         SourceDocument             @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  annotationSetRevisions AnnotationSetRevision[]
  extractions            Extraction[]
  batchMembers           BatchExtractionMember[]
  batchSchemaSuggestionSources BatchSchemaSuggestionSource[]
  extractionJobs         ExtractionJob[]

  @@unique([sourceDocumentId, revisionNumber])
  @@unique([sourceDocumentId, reprocessKey])
  @@unique([id, sourceDocumentId])
}

model AnnotationSetRevision {
  id                             Uuid                         @id @default(uuid())
  sourceDocumentId               Uuid
  sourceRepresentationRevisionId Uuid
  revisionNumber                 Int
  snapshot                       Json
  createdAt                      Timestamptz6                 @default(now())
  sourceDocument                 SourceDocument               @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, revisionNumber])
}

model ExtractionSchema {
  id                  Uuid                       @id @default(uuid())
  projectContextId    Uuid
  name                String
  createdAt           Timestamptz6               @default(now())
  projectContext      ProjectContext             @relation(fields: [projectContextId], references: [id], onDelete: Cascade)
  schemaRevisions     SchemaRevision[]

  @@index([projectContextId])
}

model SchemaRevision {
  id                         Uuid                       @id @default(uuid())
  extractionSchemaId         Uuid
  revisionNumber             Int
  origin                     SchemaRevisionOrigin
  schemaTree                 Json
  modelAttribution           Json?
  createdAt                  Timestamptz6               @default(now())
  extractionSchema           ExtractionSchema           @relation(fields: [extractionSchemaId], references: [id], onDelete: Cascade)
  extractions                Extraction[]
  batchExtractions           BatchExtraction[]
  extractionJobs             ExtractionJob[]

  @@unique([extractionSchemaId, revisionNumber])
}

// One researcher-initiated Batch Extraction: one pinned Schema Revision and one
// Extraction Strategy applied to a chosen set of Source Documents. Its members
// are the intended selection, so progress stays truthful before every member's
// Extraction exists.
model BatchExtraction {
  id               Uuid                    @id @default(uuid())
  projectContextId Uuid
  schemaRevisionId Uuid
  strategy         String
  createdAt        Timestamptz6            @default(now())
  projectContext   ProjectContext          @relation(fields: [projectContextId], references: [id], onDelete: Cascade)
  schemaRevision   SchemaRevision          @relation(fields: [schemaRevisionId], references: [id], onDelete: Cascade)
  members          BatchExtractionMember[]
  extractions      Extraction[]
  extractionJobs   ExtractionJob[]

  @@unique([id, schemaRevisionId, strategy], map: "batch_extraction_pin_key")
  @@index([projectContextId, createdAt])
}

model BatchExtractionMember {
  batchExtractionId              Uuid
  sourceDocumentId               Uuid
  sourceRepresentationRevisionId Uuid
  initialExtractionJobId         Uuid                            @unique
  batchExtraction                BatchExtraction              @relation(fields: [batchExtractionId], references: [id], onDelete: Cascade)
  // Named explicitly: the generated identity would exceed PostgreSQL's
  // 63-character limit and be silently truncated.
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId, sourceDocumentId], references: [id, sourceDocumentId], onDelete: Cascade, map: "batch_member_representation_fkey")
  initialExtractionJob           ExtractionJob                 @relation("BatchMemberInitialJob", fields: [initialExtractionJobId, batchExtractionId, sourceDocumentId, sourceRepresentationRevisionId], references: [id, batchExtractionId, sourceDocumentId, sourceRepresentationRevisionId], onDelete: Restrict, map: "batch_member_initial_job_fkey")
  extractions                    Extraction[]                @relation("BatchMemberAttempts")

  @@id([batchExtractionId, sourceDocumentId])
  @@unique([initialExtractionJobId, batchExtractionId, sourceDocumentId, sourceRepresentationRevisionId], map: "batch_member_initial_job_key")
  @@unique([batchExtractionId, sourceDocumentId, sourceRepresentationRevisionId], map: "batch_member_exact_pin_key")
  @@index([sourceRepresentationRevisionId, sourceDocumentId], map: "batch_member_representation_idx")
}

// One durable unit of Extraction model work. Interactive and initial Batch
// Extraction member jobs share execution without becoming generic operations.
model ExtractionJob {
  id                             Uuid                    @id
  kind                           ExtractionJobKind
  projectContextId               Uuid
  sourceDocumentId               Uuid
  sourceRepresentationRevisionId Uuid
  schemaRevisionId               Uuid
  strategy                       String
  // The numbered-catalogue recipe (`id@version`) a Catalog Extraction segments by; null for generic Catalog and
  // Article. Chosen per Extraction (OpenSpec grounded-numbered-catalogue D1) and pinned in the result it produces.
  catalogRecipe                  String?
  // The Extraction Model Choice (`{fields?, reasoning?}`: kei-exp model keys per role) requested for this run; null
  // when every role keeps kei-exp's deployment default. Batch members and retries never choose.
  requestedModels                Json?
  // Read only by jobIdentityMatches' guard against pre-M1 retry rows; leaves with ExtractionJob in M4.
  retryOfId                      Uuid?
  batchExtractionId              Uuid?
  executionStatus                ProjectOperationStatus  @default(QUEUED)
  complete                       Boolean?
  modelAttribution               Json?
  diagnostics                    Json?
  resultPayload                  Json?
  failure                        Json?
  cancelRequestedAt              Timestamptz6?
  startedAt                      Timestamptz6?
  finishedAt                     Timestamptz6?
  leaseOwner                     String?
  leaseVersion                   Int                     @default(0)
  leaseExpiresAt                 Timestamptz6?
  createdAt                      Timestamptz6            @default(now())
  projectContext                 ProjectContext          @relation(fields: [projectContextId], references: [id], onDelete: Cascade)
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId, sourceDocumentId], references: [id, sourceDocumentId], onDelete: Cascade, map: "extraction_job_representation_fkey")
  schemaRevision                 SchemaRevision          @relation(fields: [schemaRevisionId], references: [id], onDelete: Cascade)
  retryOf                        ExtractionJob?          @relation("ExtractionJobRetries", fields: [retryOfId, sourceRepresentationRevisionId, schemaRevisionId, strategy], references: [id, sourceRepresentationRevisionId, schemaRevisionId, strategy], onDelete: Cascade, map: "extraction_job_retry_pin_fkey")
  retries                        ExtractionJob[]         @relation("ExtractionJobRetries")
  batchExtraction                BatchExtraction?        @relation(fields: [batchExtractionId, schemaRevisionId, strategy], references: [id, schemaRevisionId, strategy], onDelete: Cascade, map: "extraction_job_batch_pin_fkey")
  initialBatchMember             BatchExtractionMember?  @relation("BatchMemberInitialJob")

  @@unique([id, batchExtractionId, sourceDocumentId, sourceRepresentationRevisionId], map: "extraction_job_batch_member_key")
  @@unique([id, sourceRepresentationRevisionId, schemaRevisionId, strategy], map: "extraction_job_retry_pin_key")
  @@index([executionStatus, kind, createdAt])
  @@index([executionStatus, leaseExpiresAt])
  @@index([sourceDocumentId, createdAt])
  @@index([sourceRepresentationRevisionId, sourceDocumentId], map: "extraction_job_representation_idx")
  @@index([retryOfId, sourceRepresentationRevisionId, schemaRevisionId, strategy], map: "extraction_job_retry_pin_idx")
  @@index([batchExtractionId, schemaRevisionId, strategy], map: "extraction_job_batch_pin_idx")
}

// A server-owned suggestion pins every selected representation and retains every
// per-source model result. It is deliberately domain-specific rather than a
// generic job table: the saved draft and the atomic hand-off to extraction are
// part of the research workflow's durable state.
model BatchSchemaSuggestion {
  id                        Uuid                       @id @default(uuid())
  projectContextId          Uuid
  selectionKey              String                     @unique
  executionStatus           ProjectOperationStatus     @default(QUEUED)
  phase                     BatchSchemaSuggestionPhase @default(SOURCES)
  proposal                  Json?
  coverage                  Json?
  draft                     Json?
  draftVersion              Int                        @default(0)
  failure                   Json?
  confirmedSchemaRevisionId Uuid?                      @unique
  batchExtractionId         Uuid?                      @unique
  startedAt                 Timestamptz6?
  finishedAt                Timestamptz6?
  leaseOwner                String?
  leaseVersion              Int                        @default(0)
  leaseExpiresAt            Timestamptz6?
  createdAt                 Timestamptz6               @default(now())
  projectContext            ProjectContext             @relation(fields: [projectContextId], references: [id], onDelete: Cascade)
  sources                   BatchSchemaSuggestionSource[]

  @@index([projectContextId, createdAt])
  @@index([executionStatus, leaseExpiresAt])
}

model BatchSchemaSuggestionSource {
  batchSchemaSuggestionId         Uuid
  sourceDocumentId                Uuid
  sourceRepresentationRevisionId  Uuid
  executionStatus                 ProjectOperationStatus @default(QUEUED)
  definition                      Json?
  failure                         Json?
  startedAt                       Timestamptz6?
  finishedAt                      Timestamptz6?
  batchSchemaSuggestion           BatchSchemaSuggestion @relation(fields: [batchSchemaSuggestionId], references: [id], onDelete: Cascade)
  sourceRepresentationRevision    SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId], references: [id], onDelete: Restrict)

  @@id([batchSchemaSuggestionId, sourceDocumentId])
  @@unique([batchSchemaSuggestionId, sourceDocumentId, sourceRepresentationRevisionId], map: "batch_suggestion_source_pin_key")
  @@index([sourceRepresentationRevisionId, sourceDocumentId], map: "batch_suggestion_source_representation_idx")
}

model Extraction {
  id                             Uuid                         @id @default(uuid())
  sourceDocumentId               Uuid
  schemaRevisionId               Uuid
  sourceRepresentationRevisionId Uuid
  strategy                       String
  // Copied from the Extraction Job: the run's Extraction Model Choice. The models each role actually ran on are in
  // `diagnostics.models`; `modelAttribution` names the fields model.
  requestedModels                Json?
  outcome                        ExtractionOutcome
  complete                       Boolean?
  modelAttribution               Json?
  diagnostics                    Json
  failure                        Json?
  resultPayload                  Json?
  evidenceLinks                  Json?
  reviewable                     Boolean
  batchExtractionId              Uuid?
  createdAt                      Timestamptz6                 @default(now())
  reviewedAt                     Timestamptz6?
  reviewDraft                    Json?
  reviewDraftVersion             Int                          @default(0)
  schemaRevision                 SchemaRevision               @relation(fields: [schemaRevisionId], references: [id], onDelete: Cascade)
  // The composite pin makes agreement a database guarantee: an Extraction can
  // only join a Batch Extraction that pinned the same Schema Revision and
  // Extraction Strategy. A null batch is a single-document Extraction.
  batchExtraction                BatchExtraction?             @relation(fields: [batchExtractionId, schemaRevisionId, strategy], references: [id, schemaRevisionId, strategy], onDelete: Cascade, map: "extraction_batch_pin_fkey")
  // A batch attempt also has to match one selected Source Document and its
  // exact pinned Source Representation Revision.
  batchMember                    BatchExtractionMember?       @relation("BatchMemberAttempts", fields: [batchExtractionId, sourceDocumentId, sourceRepresentationRevisionId], references: [batchExtractionId, sourceDocumentId, sourceRepresentationRevisionId], onDelete: Restrict, map: "extraction_batch_member_fkey")
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId, sourceDocumentId], references: [id, sourceDocumentId], onDelete: Cascade)
  reviews                        ExtractionReview[]

  @@unique([id, sourceDocumentId])
  @@index([schemaRevisionId])
  @@index([sourceDocumentId, createdAt])
  @@index([sourceRepresentationRevisionId, sourceDocumentId])
  @@index([batchExtractionId, schemaRevisionId, strategy], map: "extraction_batch_pin_idx")
  @@index([reviewedAt])
}

model ExtractionReview {
  id             Uuid             @id @default(uuid())
  extractionId   Uuid
  revisionNumber Int
  decisionDigest String
  createdAt      Timestamptz6     @default(now())
  extraction     Extraction       @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  decisions      ReviewDecision[]

  @@unique([extractionId, revisionNumber])
}

model ReviewDecision {
  id                    Uuid             @id @default(uuid())
  extractionReviewId    Uuid
  resultPath            Json
  resultPathKey         String
  evidenceAnchorId      String
  reviewedOccurrenceIds Json
  action                String
  reviewedValue         Json?
  createdAt             Timestamptz6     @default(now())
  extractionReview      ExtractionReview @relation(fields: [extractionReviewId], references: [id], onDelete: Cascade)

  @@unique([extractionReviewId, resultPathKey])
}
