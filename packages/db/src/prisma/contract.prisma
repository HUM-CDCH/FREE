// use prisma-next
types {
  Uuid         = String @db.Uuid
  Timestamptz6 = DateTime @db.Timestamptz(6)
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

enum AttemptOutcome {
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ExtractionOutcome {
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AnnotationMode {
  hints
  fields
}

enum SchemaRevisionOrigin {
  SUGGESTION
  RESEARCHER_EDIT
  MODEL_EDIT
}

model ProjectContext {
  id                Uuid               @id @default(uuid())
  name              String
  createdAt         Timestamptz6       @default(now())
  sourceDocuments   SourceDocument[]
  extractionSchemas ExtractionSchema[]
}

model SourceDocument {
  id                     Uuid                           @id @default(uuid())
  projectContextId       Uuid
  contentSha256          String
  mediaType              String
  originalName           String?
  createdAt              Timestamptz6                   @default(now())
  projectContext         ProjectContext                 @relation(fields: [projectContextId], references: [id], onDelete: Cascade)
  representations        SourceRepresentationRevision[]
  annotationSetRevisions AnnotationSetRevision[]

  @@index([projectContextId])
  @@index([contentSha256])
}

model SourceRepresentationRevision {
  id                     Uuid                       @id @default(uuid())
  sourceDocumentId       Uuid
  revisionNumber         Int
  artifactReference      String
  artifactSha256         String
  contractVersion        String
  preprocessId           String
  parserName             String
  parserVersion          String
  createdAt              Timestamptz6               @default(now())
  sourceDocument         SourceDocument             @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  annotationSetRevisions AnnotationSetRevision[]
  schemaSuggestionInputs SchemaSuggestionInput[]
  conversationalEdits    ConversationalSchemaEdit[]
  extractions            Extraction[]

  @@unique([sourceDocumentId, revisionNumber])
  @@unique([id, sourceDocumentId])
}

model AnnotationSetRevision {
  id                             Uuid                         @id @default(uuid())
  sourceDocumentId               Uuid
  sourceRepresentationRevisionId Uuid
  revisionNumber                 Int
  snapshot                       Json
  createdAt                      Timestamptz6                 @default(now())
  sourceDocument                 SourceDocument               @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId], references: [id], onDelete: Cascade)
  schemaSuggestionInputs         SchemaSuggestionInput[]
  conversationalEdits            ConversationalSchemaEdit[]

  @@unique([sourceDocumentId, revisionNumber])
}

model ExtractionSchema {
  id                  Uuid                       @id @default(uuid())
  projectContextId    Uuid
  name                String
  createdAt           Timestamptz6               @default(now())
  projectContext      ProjectContext             @relation(fields: [projectContextId], references: [id], onDelete: Cascade)
  promptRevisions     PromptRevision[]
  schemaRevisions     SchemaRevision[]
  suggestions         SchemaSuggestion[]
  conversationalEdits ConversationalSchemaEdit[]

  @@index([projectContextId])
}

model PromptRevision {
  id                  Uuid                       @id @default(uuid())
  extractionSchemaId  Uuid
  revisionNumber      Int
  text                String
  createdAt           Timestamptz6               @default(now())
  extractionSchema    ExtractionSchema           @relation(fields: [extractionSchemaId], references: [id], onDelete: Cascade)
  suggestions         SchemaSuggestion[]
  conversationalEdits ConversationalSchemaEdit[]

  @@unique([extractionSchemaId, revisionNumber])
}

model SchemaSuggestion {
  id                 Uuid                    @id @default(uuid())
  extractionSchemaId Uuid
  promptRevisionId   Uuid?
  annotationMode     AnnotationMode
  outcome            AttemptOutcome
  modelAttribution   Json
  rawModelOutput     String?
  failure            Json?
  proposedTree       Json?
  createdAt          Timestamptz6            @default(now())
  extractionSchema   ExtractionSchema        @relation(fields: [extractionSchemaId], references: [id], onDelete: Cascade)
  promptRevision     PromptRevision?         @relation(fields: [promptRevisionId], references: [id], onDelete: Cascade)
  inputs             SchemaSuggestionInput[]
  seededRevision     SchemaRevision?

  @@index([extractionSchemaId])
}

model ConversationalSchemaEdit {
  id                             Uuid                         @id @default(uuid())
  extractionSchemaId             Uuid
  baseSchemaRevisionId           Uuid
  sourceRepresentationRevisionId Uuid
  annotationSetRevisionId        Uuid?
  promptRevisionId               Uuid?
  instruction                    String
  operations                     Json?
  outcome                        AttemptOutcome
  modelAttribution               Json
  rawModelOutput                 String?
  failure                        Json?
  proposedTree                   Json?
  createdAt                      Timestamptz6                 @default(now())
  extractionSchema               ExtractionSchema             @relation(fields: [extractionSchemaId], references: [id], onDelete: Cascade)
  baseSchemaRevision             SchemaRevision               @relation("ConversationalEditBase", fields: [baseSchemaRevisionId], references: [id], onDelete: Cascade)
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId], references: [id], onDelete: Cascade)
  annotationSetRevision          AnnotationSetRevision?       @relation(fields: [annotationSetRevisionId], references: [id], onDelete: Cascade)
  promptRevision                 PromptRevision?              @relation(fields: [promptRevisionId], references: [id], onDelete: Cascade)
  appliedRevision                SchemaRevision?              @relation("ConversationalEditApplied")

  @@index([extractionSchemaId])
}

model SchemaSuggestionInput {
  schemaSuggestionId             Uuid
  sourceRepresentationRevisionId Uuid
  annotationSetRevisionId        Uuid?
  schemaSuggestion               SchemaSuggestion             @relation(fields: [schemaSuggestionId], references: [id], onDelete: Cascade)
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId], references: [id], onDelete: Cascade)
  annotationSetRevision          AnnotationSetRevision?       @relation(fields: [annotationSetRevisionId], references: [id], onDelete: Cascade)

  @@id([schemaSuggestionId, sourceRepresentationRevisionId])
}

model SchemaRevision {
  id                         Uuid                       @id @default(uuid())
  extractionSchemaId         Uuid
  schemaSuggestionId         Uuid?                      @unique
  revisionNumber             Int
  origin                     SchemaRevisionOrigin
  schemaTree                 Json
  modelAttribution           Json?
  createdAt                  Timestamptz6               @default(now())
  extractionSchema           ExtractionSchema           @relation(fields: [extractionSchemaId], references: [id], onDelete: Cascade)
  schemaSuggestion           SchemaSuggestion?          @relation(fields: [schemaSuggestionId], references: [id], onDelete: Cascade)
  conversationalSchemaEditId Uuid?                      @unique
  conversationalSchemaEdit   ConversationalSchemaEdit?  @relation("ConversationalEditApplied", fields: [conversationalSchemaEditId], references: [id], onDelete: Cascade)
  conversationalEditBases    ConversationalSchemaEdit[] @relation("ConversationalEditBase")
  extractions                Extraction[]

  @@unique([extractionSchemaId, revisionNumber])
}

model Extraction {
  id                             Uuid                         @id @default(uuid())
  sourceDocumentId               Uuid
  schemaRevisionId               Uuid
  sourceRepresentationRevisionId Uuid
  strategy                       String
  outcome                        ExtractionOutcome
  complete                       Boolean?
  modelAttribution               Json?
  diagnostics                    Json
  failure                        Json?
  resultPayload                  Json?
  evidenceLinks                  Json?
  reviewable                     Boolean
  retryOfId                      Uuid?
  createdAt                      Timestamptz6                 @default(now())
  reviewedAt                     Timestamptz6?
  schemaRevision                 SchemaRevision               @relation(fields: [schemaRevisionId], references: [id], onDelete: Cascade)
  sourceRepresentationRevision   SourceRepresentationRevision @relation(fields: [sourceRepresentationRevisionId, sourceDocumentId], references: [id, sourceDocumentId], onDelete: Cascade)
  retryOf                        Extraction?                  @relation("ExtractionRetries", fields: [retryOfId, sourceRepresentationRevisionId, schemaRevisionId, strategy], references: [id, sourceRepresentationRevisionId, schemaRevisionId, strategy], onDelete: Cascade, map: "extraction_retry_pin_fkey")
  retries                        Extraction[]                 @relation("ExtractionRetries")
  review                         ExtractionReview?
  reviewDecisions                ReviewDecision[]

  @@unique([id, sourceDocumentId])
  @@unique([id, sourceRepresentationRevisionId, schemaRevisionId, strategy], map: "extraction_retry_pin_key")
  @@index([schemaRevisionId])
  @@index([sourceDocumentId, createdAt])
  @@index([sourceRepresentationRevisionId, sourceDocumentId])
  @@index([retryOfId, sourceRepresentationRevisionId, schemaRevisionId, strategy], map: "extraction_retry_pin_idx")
  @@index([reviewedAt])
}

model ExtractionReview {
  id             Uuid         @id @default(uuid())
  extractionId   Uuid         @unique
  decisionDigest String
  createdAt      Timestamptz6 @default(now())
  extraction     Extraction   @relation(fields: [extractionId], references: [id], onDelete: Cascade)
}

model ReviewDecision {
  id                    Uuid       @id @default(uuid())
  extractionId          Uuid
  evidenceAnchorId      String
  reviewedOccurrenceIds Json
  createdAt             Timestamptz6 @default(now())
  extraction            Extraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@unique([extractionId, evidenceAnchorId])
}
