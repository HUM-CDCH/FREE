  {
    "id": "data.backfill-schema-suggestion-owner",
    "label": "Backfill Schema Suggestion owners",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [
      {
        "description": "Verify every existing suggestion has an Extraction Schema owner",
        "sql": "SELECT NOT EXISTS (\n              SELECT 1\n              FROM public.\"schemaSuggestion\" AS suggestion\n              LEFT JOIN public.\"extractionSchema\" AS schema\n                ON schema.id = suggestion.\"extractionSchemaId\"\n              WHERE schema.id IS NULL\n            ) AS ok"
      }
    ],
    "execute": [
      {
        "description": "Copy the owning Project Context from each Extraction Schema",
        "sql": "UPDATE public.\"schemaSuggestion\" AS suggestion\n              SET \"projectContextId\" = schema.\"projectContextId\"\n              FROM public.\"extractionSchema\" AS schema\n              WHERE schema.id = suggestion.\"extractionSchemaId\""
      }
    ],
    "postcheck": [
      {
        "description": "Verify every suggestion now has a Project Context owner",
        "sql": "SELECT NOT EXISTS (\n              SELECT 1\n              FROM public.\"schemaSuggestion\"\n              WHERE \"projectContextId\" IS NULL\n            ) AS ok"
      }
    ]
  },
  {
    "id": "data.remove-obsolete-source-suggestion-cache",
    "label": "Remove obsolete private source suggestion caches",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "Delete suggestions owned by the obsolete cache schemas",
        "sql": "DELETE FROM public.\"schemaSuggestion\" AS suggestion\n              USING public.\"extractionSchema\" AS schema\n              WHERE suggestion.\"extractionSchemaId\" = schema.id\n                AND schema.name = 'Private Schema Suggestion Cache'"
      },
      {
        "description": "Delete the obsolete cache schemas",
        "sql": "DELETE FROM public.\"extractionSchema\"\n              WHERE name = 'Private Schema Suggestion Cache'"
      }
    ],
    "postcheck": [
      {
        "description": "Verify no obsolete cache schema remains",
        "sql": "SELECT NOT EXISTS (\n              SELECT 1\n              FROM public.\"extractionSchema\"\n              WHERE name = 'Private Schema Suggestion Cache'\n            ) AS ok"
      }
    ]
  },
