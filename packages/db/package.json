  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "contract:emit": "prisma-next contract emit",
    "db:reset": "tsx src/reset-database.ts && prisma-next db init",
    "db:seed": "tsx src/seed.ts",
    "db:init": "prisma-next migrate --yes",
    "db:update": "prisma-next db update",
    "db:verify": "tsx src/verify-database.ts",
    "db:migrate": "prisma-next migrate",
    "db:studio": "set -a && . ./.env && set +a && npx prisma@dev studio --url \"$DATABASE_URL\""
  },
