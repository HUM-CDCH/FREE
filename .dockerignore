# Build contexts only need tracked sources; everything below is host-local,
# generated, or a native install that must be rebuilt inside the image.
**/node_modules
**/.venv
**/dist
**/dist-lib
**/__pycache__
**/*.pyc
**/.env
**/.env.*
**/*.log
**/.design-sync

# Studio's image copies this whole context, so keys, certificates and local CLI
# or agent logins never enter it. Deployment secrets are runtime mounts only.
**/*.pem
**/*.key
**/*.crt
**/*.pfx
**/*.p12
**/.agents
**/.claude
**/.codex
**/.gemini
**/.pi
**/.mcp.json

.git
.certs
.pnpm-store
.omo
.worktrees
**/.codegraph
.dev
.scratch
.vscode
.run
.playwright-mcp
.playwright-cli
.ruff_cache
.uv-cache-*
.qlty
coverage
artifacts
packages/db/src/generated
apps/studio/test-results
apps/studio/.certs
apps/studio/.playwright-stack-*/
tools/slopo-benchmark/work
apps/parsing_service/data
apps/parsing_service/runs
