        className="cursor-pointer px-1 text-[10px] leading-none text-ink-faint outline-none transition-colors hover:text-accent focus-visible:text-accent"
        type="button"
        title={`Remove field: ${name}`}
        onClick={() => editor.onRemove(path, name)}
      >
        ✕
      </button>
    </span>
