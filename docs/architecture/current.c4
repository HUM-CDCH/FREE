specification {
  element person {
    style {
      shape person
      color blue
    }
  }
  element system
  element container
  element component
  element datastore {
    style {
      shape storage
    }
  }
  element external {
    style {
      color gray
    }
  }
}

model {
  researcher = person 'Humanities Researcher' 'Loads a Source Document, shapes a schema, runs extraction, and inspects evidence.'

  studio = system 'Studio Application' 'React UI plus same-origin TypeScript model handlers.' {
    ui = container 'React UI' 'Source Document viewer, browser-only annotations, schema editor, extraction results, evidence, and Model Connections.' 'React'
    browser_http = component 'Browser HTTP adapter' '`src/api.ts` sends parsing and same-origin model requests.' 'TypeScript'
    model_handlers = container 'Same-origin model handlers' '`api/*.ts` owns model operations and application composition.' 'TypeScript serverless handlers'
    provider_registry = component 'Provider registry' '`api/_provider.ts` resolves Capability Routes and adapts configured providers.' 'AI SDK/provider adapters'
  }

  parsing_service = system 'Parsing Service' 'FastAPI document parsing and OCR indexing service; it does not own model operations.' {
    http_api = container 'FastAPI HTTP API' '`POST /tasks`, task polling, ParsedDocument, Markdown, and artifact routes.' 'FastAPI'
    parser = component 'Canonical parsing pipeline' 'Validates PDF input and produces canonical ParsedDocument, Markdown, and parser artifacts.' 'Python, Docling, PyMuPDF, PaddleOCR, Camelot'
    content_store = datastore 'Content-addressed filesystem' 'Immutable source blobs, canonical generations, task metadata, Markdown, and parser artifacts.'
  }

  model_config = datastore 'Machine-wide model configuration and OS credential store' 'Saved Model Connections and Capability Routes; credentials remain in the operating-system keyring.'
  project_store = datastore 'Isolated Project Store implementation' 'Adopted PostgreSQL/Prisma implementation behind ProjectStore; no application runtime consumes it.' 'PostgreSQL, Prisma'
  model_connections = external 'Model Connections' 'Configured external HTTP or local CLI model providers.'

  researcher -> studio 'Uses in a browser'
  studio -> parsing_service 'Indexes Source Documents via /tasks*'
  studio -> model_connections 'Executes configured model operations'
  studio -> model_config 'Reads and updates machine-wide model configuration'

  researcher -> studio.ui 'Uses'
  studio.ui -> studio.browser_http 'Starts product flows'
  studio.browser_http -> parsing_service.http_api 'POST /tasks; poll /tasks/:id; GET Markdown'
  studio.browser_http -> studio.model_handlers 'Calls /api/* model operations'
  studio.model_handlers -> studio.provider_registry 'Resolves a Capability Route'
  studio.provider_registry -> model_config 'Reads routes, connections, and credentials'
  studio.provider_registry -> model_connections 'Calls the resolved Model Connection'
  parsing_service.http_api -> parsing_service.parser 'Runs parsing/OCR work'
  parsing_service.parser -> parsing_service.content_store 'Publishes ParsedDocument, Markdown, and artifacts'
  parsing_service.http_api -> parsing_service.content_store 'Reads task state and canonical outputs'
}

views {
  view current_context {
    title 'FREE — current runtime context'
    description '''
      Implemented runtime boundaries only. The MVP assumes one trusted machine/user: every browser session reaches the same model handlers and machine-wide credential store.

      The disconnected Project Store is adopted and implemented in isolation, but no application runtime consumes it.
    '''
    include researcher, studio, parsing_service, model_config, project_store, model_connections
  }

  view current_modules {
    title 'FREE — current runtime modules'
    description 'Maintained module seams; this is not an import graph.'
    include researcher, studio.*, parsing_service.*, model_config, project_store, model_connections
  }

  dynamic view source_document_ingestion {
    title 'Non-bundled Source Document ingestion and view — current'
    description 'Implemented; deterministic evidence covers the browser viewer and backend lifecycle separately.'
    researcher -> studio.ui 'Open a non-bundled Source Document'
    studio.ui -> studio.browser_http 'Load the PDF locally and begin document indexing'
    studio.browser_http -> parsing_service.http_api 'POST /tasks'
    parsing_service.http_api -> parsing_service.parser 'Validate and parse the PDF'
    parsing_service.parser -> parsing_service.content_store 'Publish ParsedDocument, Markdown, and artifacts'
    loop 'until parsing completes' {
      studio.browser_http -> parsing_service.http_api 'GET /tasks/:taskId'
    }
    studio.browser_http -> parsing_service.http_api 'GET /tasks/:taskId/markdown'
    parsing_service.http_api -> studio.browser_http 'Return canonical Markdown'
    studio.browser_http -> studio.ui 'Show the PDF and make canonical Markdown available'
  }

  dynamic view schema_guided_extraction {
    title 'Schema suggestion and schema-guided extraction — current'
    description 'Implemented; deterministic UI traces intercept model HTTP, and evidence rendering has no pixel-level assertion.'
    researcher -> studio.ui 'Choose Schema and Generate schema'
    studio.ui -> studio.browser_http 'Prepare Source Document Markdown and browser annotations'
    studio.browser_http -> studio.model_handlers 'POST /api/generate_schema'
    studio.model_handlers -> studio.provider_registry 'Resolve schema-suggestion through the saved Extraction Capability Route'
    studio.provider_registry -> model_connections 'Generate schema with the Model Connection'
    model_connections -> studio.model_handlers 'Return suggested template'
    studio.model_handlers -> studio.ui 'Show editable schema'
    researcher -> studio.ui 'Run extraction'
    studio.ui -> studio.browser_http 'Submit schema and Markdown'
    studio.browser_http -> studio.model_handlers 'POST /api/extract'
    studio.model_handlers -> studio.provider_registry 'Resolve extraction Capability Route'
    studio.provider_registry -> model_connections 'Execute schema-guided extraction'
    model_connections -> studio.model_handlers 'Return result and evidence'
    studio.model_handlers -> studio.ui 'Show Results, Raw JSON, and source-linked evidence'
  }

  dynamic view model_configuration {
    title 'Model configuration — current'
    description 'Implemented; deterministic UI tests intercept configuration/probe HTTP and server seams are covered separately.'
    researcher -> studio.ui 'Open Model Connections'
    studio.ui -> studio.model_handlers 'GET /api/model_config'
    studio.model_handlers -> model_config 'Read saved connections, routes, and credential states'
    model_config -> studio.model_handlers 'Return sanitized model configuration'
    studio.model_handlers -> studio.ui 'Show saved state without credential values'
    researcher -> studio.ui 'Edit a Model Connection or Capability Route'
    studio.ui -> studio.model_handlers 'POST /api/model_probe'
    studio.model_handlers -> studio.provider_registry 'Probe provider adapter'
    studio.provider_registry -> model_connections 'Discover models or check connectivity'
    model_connections -> studio.provider_registry 'Return discovery/connectivity result'
    studio.provider_registry -> studio.model_handlers 'Sanitize the probe result'
    studio.model_handlers -> studio.ui 'Show probe result without credentials'
    studio.ui -> studio.model_handlers 'PUT /api/model_config'
    studio.model_handlers -> model_config 'Commit configuration and keyring changes'
    model_config -> studio.model_handlers 'Return committed sanitized state'
    studio.model_handlers -> studio.ui 'Show committed configuration'
  }
}
