specification {
  element person {
    style {
      shape person
      color blue
    }
  }
  element system
  element container
  element component
  element datastore {
    style {
      shape storage
    }
  }
  element external {
    style {
      color gray
    }
  }
}

model {
  operator = person 'FREE Operator' 'Deploys FREE and assigns Researchers to the Microsoft Entra enterprise application.'
  researcher = person 'Humanities Researcher' 'Opens a Source Document, shapes an Extraction Schema, runs Extraction, and reviews Evidence.'
  browser = container 'Researcher browser' 'Runs the React client and follows OIDC redirects; it reaches production and local Compose only through their nginx TLS entry points.' 'Web browser'
  dev_browser = container 'Dev Container browser' 'Reaches the directly started Studio process on loopback HTTP; there is no nginx in this topology.' 'Web browser'
  entra = external 'Microsoft Entra ID' 'Single-tenant OIDC identity provider and the source of application assignment.'
  mock_oidc = container 'Mock OIDC service' 'The sibling development identity service. Studio uses its server issuer while the browser follows the published loopback issuer.' 'mock-oauth2-server'

  gateway = container 'Host nginx TLS gateway' 'The host nginx reverse proxy on the university machine. Terminates operator-supplied TLS, adds security headers, pins the client-address proxy contract, and forwards to Studio.' 'Nginx'
  local_gateway = container 'Container nginx TLS gateway' 'The default local Compose entry point. Terminates mkcert TLS on port 8443 and applies the same shared proxy include as host nginx.' 'Nginx'

  studio = system 'Studio Application' 'React UI plus a production Hono Node host on one authenticated same-origin boundary.' {
    ui = container 'React UI' 'Source Document viewer, browser annotations, schema editor, Extraction Results, Evidence, and Model Connections.' 'React'
    browser_http = component 'Browser HTTP adapter' '`src/api.ts`, `src/projectContexts.ts`, and `src/schemaRevisions.ts` send parsing and same-origin requests.' 'TypeScript'
    handlers = container 'Hono Node host' '`server/*.ts` authenticates and scopes browser requests, serves the built client, and dispatches `api/*.ts` same-origin handlers.' 'Hono, Node.js'
    authentication = component 'Authentication boundary' 'OIDC authorization-code transactions with PKCE and nonce validation, fixed token-expiry sessions, canonical-origin enforcement, and the trusted-proxy peer contract.' 'TypeScript, MSAL Node'
    provider_registry = component 'Provider registry' '`api/_provider.ts` resolves a Capability Route and adapts the configured provider.' 'AI SDK v7 provider adapters'
    extraction_module = component 'Extraction module' '`packages/extraction` owns Extraction execution, grounding, review, batch scheduling, and their PostgreSQL persistence.' 'TypeScript, Prisma Next'
    batch_worker = component 'Batch Extraction worker' '`packages/extraction` claims durable batch work in the Studio process and runs each member through the same Extraction module and pinned model-session boundary.' 'TypeScript'
    project_store = component 'ProjectStore' '`packages/db` owns the remaining Project Store reads and writes; handlers hold no SQL.' 'TypeScript, Prisma Next'
  }

  parsing_service = system 'Parsing Service' 'FastAPI PDF ingestion service; it owns no model operation.' {
    http_api = container 'FastAPI HTTP API' '`POST /tasks`, task polling, ParsedDocument, Markdown, PDF, and package routes.' 'FastAPI'
    parser = component 'Canonical parsing pipeline' 'Validates the PDF and publishes `parsed_document.v2`, canonical Markdown, and the package.' 'Python, Docling'
    task_cache = datastore 'Task directory' 'Processor cache: source bytes, task metadata, and the published package. Never a durable dependency.'
  }

  project_db = datastore 'Project Store' 'Researcher Accounts plus account-owned Project Contexts, Source Documents, Source Representations, Annotation Sets, Schema Revisions, Extractions, and versioned ExtractionReview records that own their Review Decisions.' 'PostgreSQL 17, Prisma Next'
  package_store = datastore 'Canonical ingestion packages' 'Content-addressed portable packages in the `FREE Studio` data directory. The Project Store keeps only the package reference.' 'Operating system data directory'
  model_config = datastore 'Model configuration and credential store' '`model-config.json` in the `FREE Studio` config directory; FREE-managed credentials stay in the operating system credential store.' 'JSON, OS keyring'
  model_connections = external 'Model Connections' 'Configured external HTTP or local CLI model providers.'

  operator -> entra 'Registers the application, rotates its certificate, and assigns Researchers'
  researcher -> browser 'Uses FREE from a web browser'
  researcher -> dev_browser 'Uses FREE from the Dev Container browser'
  browser -> gateway 'Uses the canonical private HTTPS origin'
  browser -> local_gateway 'Uses the local HTTPS origin'
  browser -> entra 'Follows Microsoft Entra authorization and sign-out redirects'
  dev_browser -> studio.handlers 'Uses direct loopback HTTP in the Dev Container'
  gateway -> studio 'Forwards requests from the pinned proxy address'
  local_gateway -> studio.handlers 'Forwards TLS requests from the dedicated proxy network'
  studio -> parsing_service 'Parses selected PDFs through same-origin ingestion'
  studio -> project_db 'Reads research state and appends durable writes'
  studio -> package_store 'Reads the pinned canonical package'
  studio -> model_config 'Reads and updates machine-wide model configuration'
  studio -> model_connections 'Executes configured model operations'
  researcher -> studio.ui 'Uses'
  gateway -> studio.handlers 'Forwards HTTPS requests with one overwritten client-address header'
  studio.ui -> studio.browser_http 'Starts product flows'
  studio.browser_http -> studio.handlers 'Calls /api/*'
  studio.handlers -> studio.authentication 'Authenticates the session and resolves its Researcher Account'
  studio.authentication -> entra 'Exchanges the authorization code and validates tenant identity claims'
  studio.authentication -> project_db 'Creates or refreshes the local account keyed by tenant and object IDs'
  studio.authentication -> mock_oidc 'Uses the mock issuer for default local and Dev Container sign-in'
  studio.handlers -> parsing_service.http_api 'POST /tasks; poll /tasks/:id; GET /tasks/:id/download'
  studio.handlers -> studio.provider_registry 'Resolves a Capability Route'
  studio.handlers -> studio.extraction_module 'Runs and reopens Extractions; records versioned reviews; schedules and reads batches'
  studio.handlers -> studio.project_store 'Reads a snapshot; creates, renames, and deletes a Project Context; appends a Schema Revision'
  studio.handlers -> package_store 'Reads the pdf, markdown, and source entries; removes the packages a deleted Project Context left unreferenced'
  studio.project_store -> project_db 'Reads and writes through Prisma Next'
  studio.extraction_module -> project_db 'Reads and writes Extraction, Evidence, versioned ExtractionReview records with owned Review Decisions, and batch state through Prisma Next'
  studio.extraction_module -> package_store 'Reads the pinned canonical representation package'
  studio.extraction_module -> studio.provider_registry 'Opens one pinned Extraction model session per attempt'
  studio.extraction_module -> studio.batch_worker 'Wakes the in-process worker after durable batch scheduling'
  studio.batch_worker -> studio.extraction_module 'Runs each claimed member through the shared Extraction boundary'
  studio.batch_worker -> project_db 'Claims batch work and persists member attempts through Prisma Next'
  studio.batch_worker -> package_store 'Reads each member’s pinned canonical representation package'
  studio.batch_worker -> studio.provider_registry 'Opens one pinned Extraction model session per claimed member'
  studio.provider_registry -> model_config 'Reads routes, connections, and credentials'
  studio.provider_registry -> model_connections 'Calls the resolved Model Connection'
  parsing_service.http_api -> parsing_service.parser 'Runs parsing work through the bounded FIFO queue'
  parsing_service.parser -> parsing_service.task_cache 'Publishes the canonical package'
  parsing_service.http_api -> parsing_service.task_cache 'Reads task state and canonical outputs'
}

views {
  view current_context {
    title 'FREE — production runtime context'
    description '''
      Implemented production runtime boundaries only. The browser reaches the
      deployment through the host nginx TLS boundary; the Hono Node host serves
      the React client and same-origin API, authenticates each browser session
      through Microsoft Entra ID, and scopes research state to its local
      Researcher Account. Model configuration and credentials remain
      deployment-wide shared state.

      The Project Store is consumed. Studio reads its research state from
      PostgreSQL and creates, renames, and deletes Project Contexts, appends
      Schema Revisions, Extractions, and versioned ExtractionReview records
      whose Review Decisions they own.
      The Parsing Service task directory stays a processor cache; the durable
      artifact is the canonical package.
    '''
    include operator, researcher, browser, entra, gateway, studio, parsing_service, project_db, package_store, model_config, model_connections
  }

  view current_modules {
    title 'FREE — current runtime modules'
    description 'Maintained module seams; this is not an import graph.'
    include operator, researcher, browser, entra, gateway, studio.*, parsing_service.*, project_db, package_store, model_config, model_connections
  }

  dynamic view current_account_session {
    title 'Researcher Account and authenticated session — current'
    description '''
      Microsoft Entra application assignment is the authorization source. A
      successful callback creates or refreshes the local account keyed by the
      tenant and object claims. The fixed FREE session expires before the ID
      token and is never renewed in place.
    '''
    operator -> entra 'Assign the Researcher to the enterprise application'
    researcher -> browser 'Open GET /auth/login on the canonical HTTPS origin'
    browser -> gateway 'Send the TLS request'
    gateway -> studio.handlers 'Forward from the pinned proxy address'
    studio.handlers -> studio.authentication 'Create a signed OIDC transaction with state, nonce, and PKCE'
    studio.authentication -> entra 'Redirect the browser, then exchange the authorization code'
    studio.authentication -> project_db 'Create or refresh the tenant/object account'
    studio.handlers -> browser 'Issue a fixed session capped before token expiry and return to the local path'
  }

  dynamic view project_context_lifecycle {
    title 'Project Context lifecycle — current'
    description '''
      The Project Context page owns rename and permanent delete; the rail owns
      create. Each write applies to the researcher's view only after the
      handler acknowledges it. The Project Store includes the authenticated
      Researcher Account in every ownership condition. Deletion removes the
      whole owned relational graph through the database cascade, then removes
      the canonical packages no remaining Source Representation references —
      best effort, because the durable deletion has already succeeded.

      Packages are content-addressed and shared, so each address is checked,
      quarantined, then rechecked before unlinking. A concurrent publish restores
      the package; an unreadable reference answer keeps it.
    '''
    researcher -> studio.ui 'Name a new Project Context in the rail'
    studio.ui -> studio.handlers 'POST /api/project-contexts'
    studio.handlers -> studio.project_store 'createProjectContext'
    studio.project_store -> project_db 'Insert the Project Context'
    studio.handlers -> studio.ui 'Return the durable identity; its Project Context page opens'
    researcher -> studio.ui 'Rename it on its Project Context page'
    studio.ui -> studio.handlers 'PATCH /api/project-contexts/:id'
    studio.handlers -> studio.project_store 'renameProjectContext'
    studio.project_store -> project_db 'Update the name'
    researcher -> studio.ui 'Confirm permanent deletion'
    studio.ui -> studio.handlers 'DELETE /api/project-contexts/:id'
    studio.handlers -> studio.project_store 'deleteProjectContext'
    studio.project_store -> project_db 'Delete the Project Context and its cascaded research state'
    studio.project_store -> studio.handlers 'Return the pinned packages as removal candidates'
    studio.handlers -> studio.project_store 'isPackageReferenced, per candidate address'
    studio.handlers -> package_store 'Quarantine the unreferenced address'
    package_store -> studio.project_store 'Recheck the address before unlinking it'
    studio.handlers -> package_store 'Remove or restore the quarantined address, logging any failure'
  }

  dynamic view source_document_reopen {
    title 'Reopen a durable Source Document — current'
    description 'The durable, account-scoped path. The browser never reaches the Parsing Service here; the owned database query and pinned package answer every artifact read.'
    researcher -> studio.ui 'Select a Project Context'
    studio.ui -> studio.handlers 'GET /api/project-contexts'
    studio.handlers -> studio.project_store 'listProjectContexts'
    studio.project_store -> project_db 'Read the Project Contexts and their Source Documents'
    studio.handlers -> studio.ui 'Return the navigation tree'
    researcher -> studio.ui 'Select a Source Document'
    studio.ui -> studio.handlers 'GET /api/project-contexts/:id/source-documents/:id/reopen'
    studio.handlers -> studio.project_store 'getDocumentReopenSnapshot'
    studio.project_store -> project_db 'Read the pinned Representation, Annotation Set, schema, and last Extraction'
    studio.handlers -> studio.ui 'Return the snapshot with artifact URLs'
    studio.ui -> studio.handlers 'GET /api/source-representations/:id/pdf, /markdown, and /source'
    studio.handlers -> package_store 'Read the pinned package entries'
    studio.handlers -> studio.ui 'Return the PDF, canonical Markdown, and parsed_document.v2'
  }

  dynamic view source_document_ingestion {
    title 'Add Source Documents — current'
    description '''
      The Project Context page submits selected PDFs one at a time. Each
      in-flight PDF shows as the card it will become, and the acknowledged
      Source Document replaces that card. The same-origin handler retains each
      canonical package before publishing its durable Source Document and
      revision 1 Source Representation under the authenticated account's owned
      Project Context.
    '''
    researcher -> studio.ui 'Add one or more PDFs'
    studio.ui -> studio.browser_http 'POST one PDF and its stable ingestion key'
    studio.browser_http -> studio.handlers 'POST /api/project-contexts/:id/source-documents'
    studio.handlers -> parsing_service.http_api 'POST /tasks'
    parsing_service.http_api -> parsing_service.parser 'Validate and parse the PDF'
    parsing_service.parser -> parsing_service.task_cache 'Publish the canonical package'
    loop 'until parsing completes' {
      studio.handlers -> parsing_service.http_api 'GET /tasks/:taskId'
    }
    studio.handlers -> parsing_service.http_api 'GET /tasks/:taskId/download'
    parsing_service.http_api -> studio.handlers 'Return the canonical package'
    studio.handlers -> package_store 'Retain and validate the canonical package'
    studio.handlers -> studio.project_store 'Create Source Document and revision 1'
    studio.project_store -> project_db 'Commit the durable ingestion result'
    studio.handlers -> studio.ui 'Return the saved Source Document'
  }

  dynamic view schema_guided_extraction {
    title 'Schema Suggestion to reviewed Extraction — current'
    description '''
      The Extraction Route serves Schema Suggestion, Extraction, and Evidence
      grounding. The Interaction Route serves chat and conversational schema
      edits. The Extraction module resolves one model session for an attempt,
      then uses that pinned route for values and every grounding batch. Review
      finalization appends versioned ExtractionReview revision 1, which owns
      its Review Decisions; Review Decisions never attach directly to an
      Extraction.

      `POST /api/schema-revisions` initializes the first Schema Revision, or
      appends the next one against `expectedRevisionNumber`. A stale number
      returns a revision conflict rather than an overwrite.
    '''
    researcher -> studio.ui 'Annotate the Source Document and choose Generate schema'
    studio.ui -> studio.browser_http 'Prepare the Markdown and the browser Annotations'
    studio.browser_http -> studio.handlers 'POST /api/generate_schema'
    studio.handlers -> studio.provider_registry 'Resolve the Extraction Route'
    studio.provider_registry -> model_connections 'Generate the schema, raw NuExtract or general protocol'
    model_connections -> studio.handlers 'Return the suggested schema'
    studio.handlers -> studio.ui 'Show the editable Extraction Schema'
    researcher -> studio.ui 'Edit a field, or ask for a change in chat'
    studio.ui -> studio.handlers 'POST /api/edit_schema'
    studio.handlers -> studio.provider_registry 'Resolve the Interaction Route'
    studio.provider_registry -> model_connections 'Propose the schema changes'
    studio.ui -> studio.handlers 'POST /api/schema-revisions'
    studio.handlers -> studio.project_store 'initializeSchemaRevision or appendSchemaRevision'
    studio.project_store -> project_db 'Append the immutable Schema Revision'
    studio.handlers -> studio.ui 'Return the new Current Schema Revision'
    researcher -> studio.ui 'Run extraction'
    studio.ui -> studio.handlers 'POST /api/extractions with the pinned Source Representation and Schema Revision'
    studio.handlers -> studio.extraction_module 'Execute the Extraction attempt'
    studio.extraction_module -> studio.provider_registry 'Open one pinned Extraction model session'
    studio.provider_registry -> model_connections 'Extract values, then ground bounded claim batches'
    studio.extraction_module -> package_store 'Read the pinned parsed_document.v2 and canonical anchors'
    studio.extraction_module -> project_db 'Persist the attempt, Evidence, issues, and grounding diagnostics'
    studio.handlers -> studio.ui 'Show Results, diagnostics, and source-linked Evidence'
    researcher -> studio.ui 'Accept the Extraction Result'
    studio.ui -> studio.handlers 'POST /api/extractions/:id/reviews'
    studio.handlers -> studio.extraction_module 'Validate Evidence and record the review'
    studio.extraction_module -> project_db 'Create ExtractionReview revision 1 and its owned Review Decisions in one transaction'
    studio.handlers -> studio.ui 'Return the reviewed Extraction identity'
  }

  dynamic view local_compose_topology {
    title 'Local development — default Compose topology'
    description '''
      `pnpm dev` runs compose.yaml with compose.override.yaml: the browser uses
      the container nginx TLS entry point; Studio, PostgreSQL, the Parsing
      Service, and mock OIDC are sibling Compose services. Studio redeems tokens
      against the mock service over the app network.
    '''
    researcher -> browser 'Open https://localhost:8443/free'
    browser -> local_gateway 'Send the TLS request'
    local_gateway -> studio.handlers 'Forward to Studio on the proxy network'
    studio.handlers -> studio.authentication 'Start the normal OIDC session path'
    studio.authentication -> mock_oidc 'Authorize and redeem against the development issuer'
    studio.handlers -> parsing_service.http_api 'Submit and poll parsing tasks'
    studio.handlers -> studio.project_store 'Read and write account-owned research state'
    studio.project_store -> project_db 'Persist through Prisma Next'
  }

  dynamic view local_entra_topology {
    title 'Local development — Compose with Microsoft Entra'
    description '''
      `pnpm dev -- --entra` adds compose.entra.yaml. The local nginx TLS entry
      point and the Studio, PostgreSQL, and Parsing Service topology stay the
      same; FREE_ENTRA_REAL selects Microsoft Entra instead of the mock issuer.
      The merged mock container may still run, but Studio does not use it.
    '''
    researcher -> browser 'Open https://localhost:8443/free'
    browser -> local_gateway 'Send the TLS request'
    local_gateway -> studio.handlers 'Forward to Studio on the proxy network'
    studio.handlers -> studio.authentication 'Start the normal OIDC session path'
    studio.authentication -> entra 'Authorize and redeem against the real tenant'
    studio.handlers -> parsing_service.http_api 'Submit and poll parsing tasks'
    studio.handlers -> studio.project_store 'Read and write account-owned research state'
    studio.project_store -> project_db 'Persist through Prisma Next'
  }

  dynamic view devcontainer_topology {
    title 'Local development — Dev Container topology'
    description '''
      With FREE_DEVCONTAINER=1, the launcher starts Studio and the Parsing
      Service directly in the workspace on loopback HTTP. PostgreSQL and mock
      OIDC are sibling Dev Container Compose services; nginx is absent, and
      `--entra` is rejected for this topology.
    '''
    researcher -> dev_browser 'Open http://localhost:5173/free'
    dev_browser -> studio.handlers 'Call the directly started Studio process'
    studio.handlers -> studio.authentication 'Start the normal OIDC session path'
    studio.authentication -> mock_oidc 'Redeem against the sibling development issuer'
    studio.handlers -> parsing_service.http_api 'Call the directly started process on port 8055'
    studio.handlers -> studio.project_store 'Read and write account-owned research state'
    studio.project_store -> project_db 'Persist to sibling PostgreSQL'
  }

  dynamic view model_configuration {
    title 'Model configuration — current'
    description 'A fresh installation is unconfigured. Discovery is advisory: it never generates content, changes credentials, or gates Apply.'
    researcher -> studio.ui 'Open Model Connections'
    studio.ui -> studio.handlers 'GET /api/model_config'
    studio.handlers -> model_config 'Read the saved connections, routes, and credential states'
    model_config -> studio.handlers 'Return the sanitized model configuration'
    studio.handlers -> studio.ui 'Show the saved state without credential values'
    researcher -> studio.ui 'Edit a Model Connection or Capability Route'
    studio.ui -> studio.handlers 'POST /api/model_probe'
    studio.handlers -> studio.provider_registry 'Probe the provider adapter'
    studio.provider_registry -> model_connections 'Discover models or check connectivity'
    model_connections -> studio.provider_registry 'Return the discovery or connectivity result'
    studio.provider_registry -> studio.handlers 'Sanitize the probe result'
    studio.handlers -> studio.ui 'Show the probe result without credentials'
    studio.ui -> studio.handlers 'PUT /api/model_config'
    studio.handlers -> model_config 'Commit the configuration and the keyring changes'
    model_config -> studio.handlers 'Return the committed sanitized state'
    studio.handlers -> studio.ui 'Show the committed configuration'
  }
}
